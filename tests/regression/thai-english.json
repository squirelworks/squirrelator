{
  "schema": "squirrelator-regression-pair/1",
  "language": "thai",
  "into": "english",
  "about": "Vendored from LanguageStudentDesk translation-learner/tests/thai-english.json accept lists; source text rendered from the pinned meaning-matrix column.",
  "cases": [
    {
      "sentence": "dont-know",
      "source": "ผมไม่รู้.",
      "expect": [
        "I don't know.",
        "I do not know."
      ]
    },
    {
      "sentence": "dont-understand",
      "source": "ผมไม่เข้าใจ.",
      "expect": [
        "I don't understand.",
        "I do not understand.",
        "I didn't understand."
      ]
    },
    {
      "sentence": "drink-water",
      "source": "ผมดื่มน้ำ.",
      "expect": [
        "I drink water.",
        "I'm drinking water.",
        "I drank water.",
        "I'll drink water."
      ]
    },
    {
      "sentence": "go-school",
      "source": "ผมไปโรงเรียน.",
      "expect": [
        "I go to school.",
        "I'm going to school.",
        "I went to school.",
        "I'll go to school."
      ]
    },
    {
      "sentence": "going-home",
      "source": "ผมไปบ้าน.",
      "expect": [
        "I am going home.",
        "I'm going home.",
        "I go home."
      ]
    },
    {
      "sentence": "hello",
      "source": "สวัสดี.",
      "expect": [
        "Hello.",
        "Hi."
      ]
    },
    {
      "sentence": "hot-today",
      "source": "วันนี้ร้อน.",
      "expect": [
        "It is hot today.",
        "It's hot today.",
        "Today is hot."
      ]
    },
    {
      "sentence": "how-much-this",
      "source": "อันนี้เท่าไร?",
      "expect": [
        "How much is this?"
      ]
    },
    {
      "sentence": "i-am-student",
      "source": "ผมเป็นนักเรียน.",
      "expect": [
        "I am a student.",
        "I'm a student.",
        "I'm a pupil."
      ]
    },
    {
      "sentence": "like-coffee",
      "source": "ผมชอบกาแฟ.",
      "expect": [
        "I like coffee.",
        "I love coffee."
      ]
    },
    {
      "sentence": "like-tea",
      "source": "ผมชอบชา.",
      "expect": [
        "I like tea.",
        "I love tea."
      ]
    },
    {
      "sentence": "speak-english",
      "source": "คุณพูดภาษาอังกฤษไหม?",
      "expect": [
        "Do you speak English?"
      ]
    },
    {
      "sentence": "thank-you",
      "source": "ขอบคุณ.",
      "expect": [
        "Thank you.",
        "Thanks."
      ]
    },
    {
      "sentence": "this-is-book",
      "source": "นี่คือหนังสือ.",
      "expect": [
        "This is a book.",
        "It's a book."
      ]
    },
    {
      "sentence": "want-coffee",
      "source": "ผมอยากกาแฟ.",
      "expect": [
        "I want coffee.",
        "I'd like coffee."
      ]
    },
    {
      "sentence": "where-going",
      "source": "คุณไปที่ไหน?",
      "expect": [
        "Where are you going?",
        "Where do you go?",
        "Where are you headed?"
      ]
    }
  ]
}
