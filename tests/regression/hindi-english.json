{
  "schema": "squirrelator-regression-pair/1",
  "language": "hindi",
  "into": "english",
  "about": "Vendored from LanguageStudentDesk translation-learner/tests/hindi-english.json accept lists; source text rendered from the pinned meaning-matrix column.",
  "cases": [
    {
      "sentence": "dont-understand",
      "source": "मैं नहीं समझा।",
      "expect": [
        "I don't understand.",
        "I do not understand.",
        "I didn't understand."
      ]
    },
    {
      "sentence": "drink-water",
      "source": "मैं पानी पीता हूँ।",
      "expect": [
        "I drink water.",
        "I'm drinking water.",
        "I drank water.",
        "I'll drink water."
      ]
    },
    {
      "sentence": "give-water",
      "source": "मुझे पानी दीजिए।",
      "expect": [
        "Please give me water.",
        "Give me water, please."
      ]
    },
    {
      "sentence": "going-home",
      "source": "मैं घर जा रहा हूँ।",
      "expect": [
        "I am going home.",
        "I'm going home.",
        "I go home."
      ]
    },
    {
      "sentence": "hot-today",
      "source": "आज गर्मी है।",
      "expect": [
        "It is hot today.",
        "It's hot today.",
        "Today is hot."
      ]
    },
    {
      "sentence": "how-much-this",
      "source": "यह कितने का है?",
      "expect": [
        "How much is this?"
      ]
    },
    {
      "sentence": "i-am-student",
      "source": "मैं छात्र हूँ।",
      "expect": [
        "I am a student.",
        "I'm a student.",
        "I'm a pupil."
      ]
    },
    {
      "sentence": "like-tea",
      "source": "मुझे चाय पसंद है।",
      "expect": [
        "I like tea.",
        "I love tea."
      ]
    },
    {
      "sentence": "speak-hindi",
      "source": "मैं हिंदी बोलता हूँ।",
      "expect": [
        "I speak Hindi."
      ]
    },
    {
      "sentence": "thank-you",
      "source": "धन्यवाद।",
      "expect": [
        "Thank you.",
        "Thanks."
      ]
    },
    {
      "sentence": "this-is-book",
      "source": "यह किताब है।",
      "expect": [
        "This is a book.",
        "It's a book."
      ]
    },
    {
      "sentence": "where-station",
      "source": "स्टेशन कहाँ है?",
      "expect": [
        "Where is the station?",
        "Where's the station?"
      ]
    }
  ]
}
