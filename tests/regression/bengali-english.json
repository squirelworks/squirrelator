{
  "schema": "squirrelator-regression-pair/1",
  "language": "bengali",
  "into": "english",
  "about": "Vendored from LanguageStudentDesk translation-learner/tests/bengali-english.json accept lists; source text rendered from the pinned meaning-matrix column.",
  "cases": [
    {
      "sentence": "dont-know",
      "source": "আমি জানি না।",
      "expect": [
        "I don't know.",
        "I do not know."
      ]
    },
    {
      "sentence": "dont-understand",
      "source": "আমি বুঝি না।",
      "expect": [
        "I don't understand.",
        "I do not understand.",
        "I didn't understand."
      ]
    },
    {
      "sentence": "drink-water",
      "source": "আমি জল খাই।",
      "expect": [
        "I drink water.",
        "I'm drinking water.",
        "I drank water.",
        "I'll drink water."
      ]
    },
    {
      "sentence": "eat-rice",
      "source": "আমরা ভাত খাই।",
      "expect": [
        "We eat rice.",
        "We're eating rice.",
        "We ate rice.",
        "We'll eat rice."
      ]
    },
    {
      "sentence": "give-water",
      "source": "দয়া করে আমাকে জল দিন।",
      "expect": [
        "Please give me water.",
        "Give me water, please."
      ]
    },
    {
      "sentence": "go-school",
      "source": "আমি স্কুলে যাই।",
      "expect": [
        "I go to school.",
        "I'm going to school.",
        "I went to school.",
        "I'll go to school."
      ]
    },
    {
      "sentence": "going-home",
      "source": "আমি বাড়ি যাই।",
      "expect": [
        "I am going home.",
        "I'm going home.",
        "I go home."
      ]
    },
    {
      "sentence": "have-cat",
      "source": "আমার একটা বিড়াল আছে।",
      "expect": [
        "I have a cat."
      ]
    },
    {
      "sentence": "hello",
      "source": "নমস্কার।",
      "expect": [
        "Hello.",
        "Hi."
      ]
    },
    {
      "sentence": "hot-today",
      "source": "আজ গরম।",
      "expect": [
        "It is hot today.",
        "It's hot today.",
        "Today is hot."
      ]
    },
    {
      "sentence": "how-much-this",
      "source": "এটা কত?",
      "expect": [
        "How much is this?"
      ]
    },
    {
      "sentence": "i-am-student",
      "source": "আমি ছাত্র।",
      "expect": [
        "I am a student.",
        "I'm a student.",
        "I'm a pupil."
      ]
    },
    {
      "sentence": "speak-english",
      "source": "আপনি কি ইংরেজি বলেন?",
      "expect": [
        "Do you speak English?"
      ]
    },
    {
      "sentence": "thank-you",
      "source": "ধন্যবাদ।",
      "expect": [
        "Thank you.",
        "Thanks."
      ]
    },
    {
      "sentence": "this-is-book",
      "source": "এটা বই।",
      "expect": [
        "This is a book.",
        "It's a book."
      ]
    },
    {
      "sentence": "where-going",
      "source": "তুমি কোথায় যাচ্ছ?",
      "expect": [
