      "expect": [
        "I don't know.",
        "I do not know."
      ]
    },
    {
      "sentence": "dont-understand",
      "source": "אני לא מבין.",
      "expect": [
        "I don't understand.",
        "I do not understand.",
        "I didn't understand."
      ]
    },
    {
      "sentence": "drink-water",
      "source": "אני שותה מים.",
      "expect": [
        "I drink water.",
        "I'm drinking water.",
        "I drank water.",
        "I'll drink water."
      ]
    },
    {
      "sentence": "from-egypt",
      "source": "אני ממצרים.",
      "expect": [
        "I am from Egypt.",
        "I'm from Egypt."
      ]
    },
    {
