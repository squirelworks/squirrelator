{
  "schema": "squirrelator-regression-pair/1",
  "language": "hebrew",
  "into": "english",
  "about": "Vendored from LanguageStudentDesk translation-learner/tests/hebrew-english.json accept lists; source text rendered from the pinned meaning-matrix column.",
  "cases": [
