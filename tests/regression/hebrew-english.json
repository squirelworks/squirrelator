      "sentence": "speak-english",
      "source": "אתה מדבר אנגלית?",
      "expect": [
        "Do you speak English?"
      ]
    },
    {
      "sentence": "thank-you",
      "source": "תודה.",
      "expect": [
        "Thank you.",
        "Thanks."
      ]
    },
    {
      "sentence": "this-is-book",
